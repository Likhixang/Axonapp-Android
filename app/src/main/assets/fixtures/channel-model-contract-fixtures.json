    {
      "label": "full settings/policies/endpoints/sync",
      "variables": {
        "id": "1",
        "input": {
          "settings": {
            "extraModelPrefix": "prefix",
            "modelMappings": [
              {
                "from": "alias",
                "to": "chat"
              }
            ],
            "autoTrimedModelPrefixes": [
              "provider"
            ],
            "hideOriginalModels": false,
            "hideMappedModels": true,
            "lowercaseModelId": true,
            "proxy": {
              "type": "URL",
              "url": "https://proxy.invalid",
              "username": "fixture",
              "password": "fixture"
            },
            "transformOptions": {
              "forceArrayInstructions": true,
              "forceArrayInputs": false,
              "replaceDeveloperRoleWithSystem": true,
              "reasoningEffortMapping": [
                {
                  "from": "xhigh",
                  "to": "high"
                }
              ]
            },
            "headerOverrideOperations": [
              {
                "op": "set",
                "path": "X-Client",
                "value": "fixture"
              }
            ],
            "bodyOverrideOperations": [
              {
                "op": "array_insert",
                "path": "messages",
                "value": "{\"role\":\"system\",\"content\":\"fixture\"}",
                "index": 0,
                "splat": false
              }
            ],
            "passThroughUserAgent": true,
            "passThroughBody": false,
            "rateLimit": {
              "rpm": 100,
              "tpm": 1000,
              "maxConcurrent": 4,
              "queueSize": 8,
              "queueTimeoutMs": 1000
            },
            "retryableStatusCodes": [
              429,
              503
            ],
            "retryableErrorPatterns": [
              {
                "pattern": "rate limit",
                "regex": false
              }
            ],
            "modelProtocols": [
              {
                "model": "chat",
                "apiFormats": [
                  "openai/chat_completions"
                ],
                "enabled": true
              }
            ],
            "providerQuota": null
          },
          "policies": {
            "stream": "require",
            "apiKeyAutoDisableRules": [
              {
                "statusCodes": [
                  429
                ],
                "keywordPatterns": [
                  "rate"
                ],
                "times": 2,
                "action": "disable_until_cron",
                "disableUntilCron": "0 0 * * *",
                "disableUntilTimezone": "UTC"
              }
            ]
          },
          "endpoints": [
            {
              "apiFormat": "openai/chat_completions",
              "path": "/chat/completions",
              "baseURL": "https://upstream.invalid",
              "transport": "http"
            }
          ],
          "autoSyncSupportedModels": true,
          "autoSyncModelPattern": "^chat",
          "manualModels": [
            "chat"
          ]
        }
      }
    }
  ],
